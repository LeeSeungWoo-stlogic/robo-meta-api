# =============================================================================
# robo-meta-api .env.example
# =============================================================================
# 본 파일은 git 추적 대상. 실제 시크릿은 .env 에만 두고 절대 커밋하지 않는다.
# (.gitignore 가 .env 를 차단)
# =============================================================================

# --- API 서버 ---
API_HOST=0.0.0.0
API_PORT=8099

# join_groups 3단 fallback
JOIN_ONTOLOGY_ENABLED=1
JOIN_CONVENTION_ENABLED=1
JOIN_CONVENTION_MIN_COL_LEN=4
JOIN_CONVENTION_CONFIDENCE=0.5
JOIN_CONVENTION_CONFIDENCE_MISMATCH=0.35
JOIN_ONTOLOGY_REL_TYPES=fkToTable,FK_TO_TABLE,RELATED_TO,REFERENCES,DOMAIN_RELATED,dataFlowsTo
JOIN_CONVENTION_EXCLUDE=id,seq,yn,use_yn,del_yn,reg_dt,upd_dt,reg_id,upd_id,remark,memo,note
JOIN_FK_LIMIT=50
JOIN_ONTOLOGY_LIMIT=50
JOIN_CONVENTION_LIMIT=30
NEO4J_TABLE_VECTOR_INDEX=text_to_sql_table_vec_index
# DECISION_SCHEMA_ALLOWLIST=rwis,public

# --- Neo4j (메타 그래프, robo-neo4j 컨테이너) ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>  # 예: robo-neo4j 의 NEO4J_AUTH 와 동일

# --- 원천 PostgreSQL (SQL 실행 대상, robo-postgres 컨테이너) ---
SOURCE_PG_HOST=127.0.0.1
SOURCE_PG_PORT=5432
SOURCE_PG_DB=rwis
SOURCE_PG_USER=postgres
SOURCE_PG_PASS=<your-pg-password>  # 예: robo-postgres 의 POSTGRES_PASSWORD 와 동일
SOURCE_PG_SCHEMA=RWIS

# --- OpenAI (HyDE + 임베딩) ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# --- decision 정책 ---
DECISION_VECTOR_TOPK=10
DECISION_COLUMN_TOP_M=10
DECISION_MATCH_COLUMNS=1
DECISION_ANALYTIC_THRESHOLD=0.70
DECISION_SOURCE_THRESHOLD=0.55
HYDE_WEIGHT=0.6
QUESTION_WEIGHT=0.4

# --- meta_db 라벨 폴백 (R-3 정책: Schema.db || DataSource.engine || META_DB_LABEL) ---
META_DB_LABEL=kwater_prod

# --- /query/execute 정책 (K-AIR 그대로) ---
EXEC_DEFAULT_TIMEOUT_S=10
EXEC_MAX_TIMEOUT_S=30
EXEC_DEFAULT_MAX_ROWS=1000
EXEC_MAX_ROWS_HARD=10000
EXEC_MAX_BYTES=10485760
EXEC_AUDIT_LOG_PATH=./logs/query_audit.jsonl
