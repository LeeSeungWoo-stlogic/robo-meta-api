# =============================================================================
# robo-meta-api .env.example
# =============================================================================
# 본 파일은 git 추적 대상. 실제 시크릿은 .env 에만 두고 절대 커밋하지 않는다.
# (.gitignore 가 .env 를 차단)
# 비밀값이 아닌 runtime 정책은 config/runtime-settings.*.local.yaml에서 관리한다.
# =============================================================================

# --- active runtime ---
API_HOST=0.0.0.0
API_PORT=8100
ROBO_RUNTIME_SETTINGS_FILE=/app/config/runtime-settings.docker.local.yaml
METADATA_PG_PASSWORD=
OPENAI_API_KEY=

# T2SQL 생성 모델. 미설정이면 POST /t2sql 은 200 + UPSTREAM_UNAVAILABLE.
# YAML t2sql.model 보다 이 값이 우선한다.
T2SQL_LLM_MODEL=

# --- 잔존 키: 코드에서 사용하지 않음 (V2 Semantic View 폐기) ---
V2_PG_DSN=
V2_PG_SCHEMA=public
V2_TENANT_ID=kwater

# --- 선택: v1 entity value probe용 원천 PostgreSQL ---
# /query_execute는 이 연결이 아니라 server-side binding + MindsDB를 사용한다.
SOURCE_PG_HOST=127.0.0.1
SOURCE_PG_PORT=5432
SOURCE_PG_DB=rwis
SOURCE_PG_USER=postgres
SOURCE_PG_PASS=
SOURCE_PG_SCHEMA=RWIS

# --- v0.7 entity resolution ---
ENTITY_RESOLUTION_ENABLED=1
ENTITY_PROBE_DATASOURCE=rwis

# embedding dimension, HyDE model, source bindings, query execution 제한은
# runtime-settings.docker.local.yaml에서 설정한다. 현재 serving 계약은 1024차원이다.
