# =============================================================================
# robo-meta-api .env.example
# =============================================================================
# git 추적 대상. 시크릿은 .env 에만 두고 커밋하지 않는다.
# Store 접속·임베딩·실행 한도는 config/runtime-settings.*.local.yaml.
# 원천 PG(SOURCE_PG_*/PG_*)·V2_PG_*·META_DB_LABEL·ENTITY_* 는 본 경로가 아니다.
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8100
TZ=Asia/Seoul
ROBO_RUNTIME_SETTINGS_FILE=/app/config/runtime-settings.docker.local.yaml
METADATA_PG_PASSWORD=
OPENAI_API_KEY=

# YAML t2sql.model 보다 우선. 비우면 POST /t2sql 은 200 + UPSTREAM_UNAVAILABLE.
T2SQL_LLM_MODEL=
