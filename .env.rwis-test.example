# RWIS 실데이터 테스트 — robo-meta-api
# 사용: copy .env.rwis-test.example .env  후 OPENAI_API_KEY, NEO4J_PASSWORD 채우기

API_HOST=0.0.0.0
API_PORT=8100

NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345strategy

SOURCE_PG_HOST=127.0.0.1
SOURCE_PG_PORT=5434
SOURCE_PG_DB=rwis
SOURCE_PG_USER=postgres
SOURCE_PG_PASS=postgres123
SOURCE_PG_SCHEMA=rwis

OPENAI_API_KEY=
# GenOS LLMOps (폐쇄망 OA) — chat/embedding serving_id 분리, 끝 /v1 권장
OPENAI_BASE_URL=http://10.40.4.215:30908/api/gateway/rep/serving/16/v1
OPENAI_EMBEDDING_BASE_URL=http://10.40.4.215:30908/api/gateway/rep/serving/10/v1
OPENAI_LLM_MODEL=gpt-oss-120b
OPENAI_EMBEDDING_MODEL=bge-m3
OPENAI_EMBEDDING_DIM=1024

META_DB_LABEL=rwis
DECISION_SCHEMA_ALLOWLIST=rwis

ENTITY_RESOLUTION_ENABLED=1

# entity resolution db_probe (컨테이너 밖 로컬 실행 시)
PG_HOST=127.0.0.1
PG_PORT=5434
PG_DATABASE=rwis
PG_USER=postgres
PG_PASSWORD=postgres123
PG_SCHEMAS=rwis

JOIN_ONTOLOGY_ENABLED=1
JOIN_CONVENTION_ENABLED=1
