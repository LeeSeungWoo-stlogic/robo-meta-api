# RWIS 실데이터 테스트 — robo-meta-api-v4
# 사용: copy .env.rwis-test.example .env  후 OPENAI_API_KEY, NEO4J_PASSWORD 채우기

API_HOST=0.0.0.0
API_PORT=8100

NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345strategy

SOURCE_PG_HOST=127.0.0.1
SOURCE_PG_PORT=5434
SOURCE_PG_DB=rwis
SOURCE_PG_USER=postgres
SOURCE_PG_PASS=postgres123
SOURCE_PG_SCHEMA=rwis

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

META_DB_LABEL=rwis
DECISION_SCHEMA_ALLOWLIST=rwis

ENTITY_RESOLUTION_ENABLED=1

# entity resolution db_probe (컨테이너 밖 로컬 실행 시)
PG_HOST=127.0.0.1
PG_PORT=5434
PG_DATABASE=rwis
PG_USER=postgres
PG_PASSWORD=postgres123
PG_SCHEMAS=rwis

JOIN_ONTOLOGY_ENABLED=1
JOIN_CONVENTION_ENABLED=1
